# Server only: Anthropic generation and translation
ANTHROPIC_API_KEY=
# Shared tutor access phrase
TUTOR_PASSPHRASE=
# At least 32 random bytes, base64 encoded
SESSION_SECRET=
# Upstash Redis REST credentials for persistent rate limits
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Firebase web app config, from Project settings > General > Your apps in the
# Firebase console (see docs/tutorials/firebase-setup.md). These are client-side
# identifiers, not secrets — they are safe to ship in the built bundle because
# access is enforced by Firestore's security rules, not by hiding the config.
# VITE_ prefix so Vite exposes them to the browser. Missing any of these
# leaves Firebase unconfigured; the app runs fine, the account drawer just
# says so. Auth + Firestore only — no Storage, which needs the paid Blaze
# plan; see the tutorial for why.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
