{
  "hosting": {
    "site": "worldbuilding-guidebook",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/lesson/([^/]+)/([^/]+)/?$",
        "destination": "/guidebook/lesson/:1/:2",
        "type": 301
      },
      {
        "regex": "^/lesson/([^/]+)/?$",
        "destination": "/guidebook/lesson/:1",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "/guidebook",
        "destination": "/guidebook/index.html"
      },
      {
        "source": "/guidebook/**",
        "destination": "/guidebook/index.html"
      },
      {
        "source": "/game",
        "destination": "/game/index.html"
      },
      {
        "source": "/game/**",
        "destination": "/game/index.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "hosting": {
      "host": "127.0.0.1",
      "port": 5002
    },
    "ui": {
      "enabled": false
    }
  }
}
